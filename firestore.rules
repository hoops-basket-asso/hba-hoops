rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasEmail() { return signedIn() && request.auth.token.email != null; }
    function bureauDoc() { return get(/databases/$(database)/documents/config/bureau); }
    function isBureau() {
      return hasEmail()
        && exists(/databases/$(database)/documents/config/bureau)
        && bureauDoc().data.emails.hasAny([request.auth.token.email, request.auth.token.email.lower()]);
    }
    function tokenOk(t, sid) {
      return t is string
        && exists(/databases/$(database)/documents/scorerTokens/$(t))
        && get(/databases/$(database)/documents/scorerTokens/$(t)).data.sid == sid
        && get(/databases/$(database)/documents/scorerTokens/$(t)).data.expires > request.time;
    }
    // Marqueur du jour : son code est déposé dans une fiche privée à son appareil (scorerClaims/{uid}).
    function scorerOk(sid) {
      return signedIn()
        && exists(/databases/$(database)/documents/scorerClaims/$(request.auth.uid))
        && tokenOk(get(/databases/$(database)/documents/scorerClaims/$(request.auth.uid)).data.token, sid);
    }
    // Ancien fonctionnement (code joint à la séance), gardé le temps que tous les téléphones soient à jour. À retirer ensuite.
    function scorerOkLegacy(sid) {
      return signedIn()
        && ('scorerToken' in request.resource.data)
        && tokenOk(request.resource.data.scorerToken, sid);
    }

    // Réglages publics (minutes, cible, seuils des badges). Jamais de secret ici.
    match /config/main {
      allow read: if true;
      allow write: if isBureau();
    }
    // Liste des emails du bureau : créée une seule fois par le premier compte email connecté, puis gérée depuis la console Firebase.
    match /config/bureau {
      allow read: if hasEmail();
      allow create: if hasEmail() && !exists(/databases/$(database)/documents/config/bureau);
      allow update, delete: if false;
    }
    // Joueurs et séances : lecture publique (stats consultables sans compte), écriture bureau ou marqueur du jour.
    match /players/{id} {
      allow read: if true;
      allow write: if isBureau();
    }
    match /sessions/{id} {
      allow read: if true;
      allow write: if isBureau() || scorerOk(id) || scorerOkLegacy(id);
    }
    // Liens marqueur : créés par le bureau. On peut vérifier un code qu'on connaît déjà, mais seul le bureau peut en voir la liste.
    match /scorerTokens/{token} {
      allow get: if signedIn();
      allow list: if isBureau();
      allow write: if isBureau();
    }
    // Fiche privée du marqueur : chaque appareil n'écrit et ne lit que la sienne.
    match /scorerClaims/{uid} {
      allow read: if isBureau() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'at'])
        && request.resource.data.token is string && request.resource.data.token.size() < 40;
    }
    // Fréquentation : chaque visiteur (connexion anonyme) incrémente le compteur du jour ; lecture bureau.
    match /visits/{day} {
      allow read: if isBureau();
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['count', 'devices', 'named']);
      allow delete: if isBureau();
    }
    // Votes de fin de saison : un bulletin par appareil (identifiant anonyme). Chacun écrit et relit le sien ; seul le bureau lit l'ensemble.
    match /votes/{uid} {
      allow read: if isBureau() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['voter', 'season', 'choices', 'at'])
        && request.resource.data.voter is string && request.resource.data.voter.size() < 60
        && request.resource.data.season is string && request.resource.data.season.size() < 20
        && request.resource.data.choices is map && request.resource.data.choices.size() <= 6;
      allow delete: if isBureau();
    }
    // Données sensibles : bureau uniquement.
    match /sanctions/{id} { allow read, write: if isBureau(); }
    match /treasury/{id}  { allow read, write: if isBureau(); }
    match /payments/{id}  { allow read, write: if isBureau(); }

    match /{document=**} { allow read, write: if false; }
  }
}
